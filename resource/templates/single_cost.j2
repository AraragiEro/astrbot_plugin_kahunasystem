<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EVE 成本计算 - {{ item_name }}</title>
  <script src="https://cdn.jsdmirror.com/npm/@tailwindcss/browser@4"></script>
  <script src="https://cdn.jsdmirror.com/npm/chart.js"></script>
  <style type="text/tailwindcss">
    @theme {
      --color-bg-dark: #0d1117;
      --color-card-bg: #161b22;
      --color-border: #30363d;
      --color-text-primary: #e6edf3;
      --color-text-secondary: #7d8590;
      --color-accent-cyan: #39d0d8;
      --color-accent-blue: #58a6ff;
      --color-profit-green: #3fb950;
      --color-loss-red: #f85149;
    }
  </style>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 12px;
      background: #0d1117;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
      color: #e6edf3;
      min-width: 526px;
      max-width: 526px;
    }
    .card {
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 8px;
      overflow: hidden;
    }
    .card-header {
      background: linear-gradient(90deg, #21262d 0%, #161b22 100%);
      border-bottom: 1px solid #30363d;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #7d8590;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .value-mono {
      font-family: "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas, monospace;
      font-variant-numeric: tabular-nums;
    }
    .glow-cyan { text-shadow: 0 0 8px rgba(57, 208, 216, 0.3); }
    .glow-green { text-shadow: 0 0 8px rgba(63, 185, 80, 0.3); }
    .glow-red { text-shadow: 0 0 8px rgba(248, 81, 73, 0.3); }
  </style>
</head>
<body>
  <!-- 头部：物品信息 -->
  <div class="card mb-3">
    <div class="p-4 flex items-center gap-4">
      <!-- 物品图标 -->
      <div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border border-[#30363d] bg-[#0d1117] flex items-center justify-center">
        <img src="https://imageserver.eveonline.com/types/{{ item_id }}/icon" 
             alt="{{ item_name }}" 
             class="w-14 h-14 object-contain"
             onerror="this.style.display='none'">
      </div>
      
      <!-- 物品信息 -->
      <div class="flex-1 min-w-0">
        <h1 class="text-lg font-bold text-white truncate" title="{{ item_name }}">{{ item_name }}</h1>
        <p class="text-sm text-[#7d8590] truncate">{{ item_name_cn }}</p>
        <div class="flex items-center gap-3 mt-2 text-xs text-[#7d8590]">
          <span class="bg-[#21262d] px-2 py-0.5 rounded">ID: {{ item_id }}</span>
          <span class="truncate max-w-[100px]">{{ user_name }}</span>
        </div>
      </div>
      
      <!-- 计划标签 -->
      <div class="flex-shrink-0 text-right">
        <span class="inline-block bg-[#39d0d8]/10 text-[#39d0d8] text-xs px-2 py-1 rounded border border-[#39d0d8]/30">
          {{ plan_name }}
        </span>
      </div>
    </div>
  </div>

  <!-- 成本与价格 -->
  <div class="grid grid-cols-2 gap-3 mb-3">
    <!-- 成本卡片 -->
    <div class="card">
      <div class="card-header flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
        制造成本
      </div>
      <div class="p-4">
        <div class="text-center mb-3">
          <span class="value-mono text-2xl font-bold text-white glow-cyan">{{ cost|default('0')|format_number }}</span>
          <span class="text-xs text-[#7d8590] ml-1">ISK</span>
        </div>
        
        <div class="grid grid-cols-2 gap-2">
          <div class="bg-[#0d1117] rounded p-2 text-center border border-[#30363d]">
            <div class="text-[10px] text-[#7d8590] uppercase mb-1">利润</div>
            <span class="value-mono text-sm font-semibold {% if profit > 0 %}text-[#3fb950] glow-green{% elif profit < 0 %}text-[#f85149] glow-red{% else %}text-[#7d8590]{% endif %}">
              {% if profit > 0 %}+{% endif %}{{ profit|default('0')|format_number }}
            </span>
          </div>
          <div class="bg-[#0d1117] rounded p-2 text-center border border-[#30363d]">
            <div class="text-[10px] text-[#7d8590] uppercase mb-1">利润率</div>
            <span class="value-mono text-sm font-semibold {% if profit_rate > 0 %}text-[#3fb950]{% elif profit_rate < 0 %}text-[#f85149]{% else %}text-[#7d8590]{% endif %}">
              {% if profit_rate > 0 %}+{% endif %}{{ (profit_rate * 100)|default('0')|format_number }}%
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- JITA 价格卡片 -->
    <div class="card">
      <div class="card-header flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
        </svg>
        JITA 市场
      </div>
      <div class="p-3 space-y-2">
        <div class="flex items-center justify-between py-1.5 px-2 rounded bg-[#0d1117] border-l-2 border-[#3fb950]">
          <span class="text-xs text-[#7d8590]">SELL</span>
          <span class="value-mono text-sm font-semibold text-[#3fb950]">{{ jita_sell|default('0')|format_number }}</span>
        </div>
        <div class="flex items-center justify-between py-1.5 px-2 rounded bg-[#0d1117] border-l-2 border-[#39d0d8]">
          <span class="text-xs text-[#7d8590]">MID</span>
          <span class="value-mono text-sm font-semibold text-[#39d0d8]">{{ jita_mid|default('0')|format_number }}</span>
        </div>
        <div class="flex items-center justify-between py-1.5 px-2 rounded bg-[#0d1117] border-l-2 border-[#f85149]">
          <span class="text-xs text-[#7d8590]">BUY</span>
          <span class="value-mono text-sm font-semibold text-[#f85149]">{{ jita_buy|default('0')|format_number }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 成本构成饼图 -->
  <div class="card mb-3">
    <div class="card-header flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/>
      </svg>
      成本构成分析
    </div>
    <div class="p-4">
      <div class="flex items-center gap-4">
        <!-- 饼图 -->
        <div class="flex-shrink-0 relative">
          <canvas id="costChart" width="140" height="140"></canvas>
          <!-- 中心文字 -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="text-center">
              <div class="text-[9px] text-[#7d8590]">总成本</div>
              <div class="value-mono text-xs font-bold text-[#39d0d8]"></div>
            </div>
          </div>
        </div>
        
        <!-- 图例 -->
        <div id="chartLegend" class="flex-1 space-y-1.5">
          <!-- JS 动态生成 -->
        </div>
      </div>
    </div>
  </div>

  <!-- 页脚 -->
  <div class="text-center py-2">
    <span class="text-[10px] text-[#7d8590]">
      <span class="text-[#39d0d8]">实验型工业核心 mk.1</span> | 成本计算系统 | kahunaBot
    </span>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const ctx = document.getElementById('costChart').getContext('2d');
      const legendContainer = document.getElementById('chartLegend');
      
      // 数据
      const labels = [{% for component in cost_components %}'{{ component.name }}'{% if not loop.last %}, {% endif %}{% endfor %}];
      const data = [{% for component in cost_components %}{{ component.value }}{% if not loop.last %}, {% endif %}{% endfor %}];
      
      // 配色方案
      const colors = [
        '#39d0d8', '#58a6ff', '#a371f7', '#fb8500', 
        '#3fb950', '#f85149', '#ec4899', '#06b6d4'
      ];
      
      // 计算总和
      const total = data.reduce((a, b) => a + b, 0);
      
      // 更新中心文字
      document.querySelector('#costChart + div .value-mono').textContent = formatNumberCompact(total);
      
      // 创建环形图 - 无动画
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: data,
            backgroundColor: colors.slice(0, labels.length),
            borderWidth: 0,
            hoverOffset: 0
          }]
        },
        options: {
          responsive: false,
          animation: false,
          cutout: '65%',
          plugins: {
            legend: { display: false },
            tooltip: { enabled: false }
          }
        }
      });
      
      // 格式化数字
      function formatNumber(num) {
        if (num >= 1000000000) return (num / 1000000000).toFixed(2) + 'B';
        if (num >= 1000000) return (num / 1000000).toFixed(2) + 'M';
        if (num >= 1000) return (num / 1000).toFixed(2) + 'K';
        return num.toLocaleString();
      }
      
      function formatNumberCompact(num) {
        if (num >= 1000000000) return (num / 1000000000).toFixed(1) + 'B';
        if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
        if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
        return num.toString();
      }
      
      // 生成图例
      labels.forEach((label, index) => {
        const value = data[index];
        const percentage = ((value / total) * 100).toFixed(1);
        const color = colors[index % colors.length];
        
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between text-xs py-1';
        item.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:${color}"></div>
            <span class="text-[#7d8590] truncate" title="${label}">${label}</span>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0 ml-2">
            <span class="value-mono text-[#e6edf3]">${formatNumber(value)}</span>
            <span class="value-mono text-[#7d8590] w-10 text-right">${percentage}%</span>
          </div>
        `;
        legendContainer.appendChild(item);
      });
    });
  </script>
</body>
</html>
